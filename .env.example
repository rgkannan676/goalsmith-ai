# Copy to .env and fill in. .env is git-ignored; never commit real keys.

# --- Models (M1) ---
ANTHROPIC_API_KEY=

# Optional overrides. Code asks for a *role*; these pick the model behind it.
# Defaults: planner/judge = claude-opus-5-5, worker = claude-sonnet-5-5, router = claude-haiku-5-5
# GOALSMITH_PLANNER__MODEL=claude-opus-5-5
# GOALSMITH_WORKER__MODEL=claude-sonnet-5-5
# GOALSMITH_ROUTER__MODEL=claude-haiku-5-5
# GOALSMITH_JUDGE__MODEL=claude-opus-5-5
# GOALSMITH_WORKER__PROVIDER=anthropic      # any registered provider
# GOALSMITH_WORKER__MAX_TOKENS=4096
# GOALSMITH_LLM_TIMEOUT_S=60
# GOALSMITH_LLM_MAX_RETRIES=3

# --- Web search (M2) ---
TAVILY_API_KEY=            # free key at https://tavily.com; without it web_search is off

# --- Runs (M2) ---
# GOALSMITH_MAX_STEPS=15               # model calls per run before a clean stop
# GOALSMITH_WORKSPACE_ROOT=workspaces  # each run writes to workspaces/<run_id>/

# --- Document search (M3) ---
# GOALSMITH_RAG__QDRANT_URL=http://localhost:6333   # `make up` starts Qdrant
# GOALSMITH_RAG__QDRANT_PATH=.qdrant                # run Qdrant in-process instead (no Docker)
# GOALSMITH_RAG__DEFAULT_COLLECTION=docs
# GOALSMITH_RAG__EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# GOALSMITH_RAG__RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2   # empty = no reranking
# GOALSMITH_RAG__CHUNK_CHARS=1200

# --- Approvals, checkpoints and memory (M4) ---
# GOALSMITH_POSTGRES_URL=postgresql://goalsmith:goalsmith@localhost:5432/goalsmith  # empty = in-memory only
# POSTGRES_PASSWORD=goalsmith            # used by docker-compose; change both together
# GOALSMITH_APPROVAL_RISKS='["write", "external"]'   # risk levels that ask before running
# GOALSMITH_USER_ID=local                # whose memories remember/recall use

# --- Tracing, logs and cost (M5) ---
# `make obs-up` starts Langfuse and creates a project with these local keys.
# Leave them unset to turn tracing off.
GOALSMITH_LANGFUSE__PUBLIC_KEY=pk-lf-goalsmith-local
GOALSMITH_LANGFUSE__SECRET_KEY=sk-lf-goalsmith-local
# GOALSMITH_LANGFUSE__HOST=http://localhost:3000
# GOALSMITH_TRACE_CONTENT=true          # false: traces keep structure and numbers, not prompts or outputs
# GOALSMITH_LOG_LEVEL=WARNING           # INFO shows one line per tool call and run, with run_id and trace_id
# GOALSMITH_LOG_FORMAT=console          # or json
# GOALSMITH_PRICES='{"my-model": {"input": 1.0, "output": 5.0, "cache_read": 0.1, "cache_write": 1.25}}'  # USD per million tokens
# LANGFUSE_ADMIN_PASSWORD=goalsmith-local  # Langfuse UI login (admin@goalsmith.local)

# --- Services (M13) ---
# REDIS_URL=redis://localhost:6379/0
